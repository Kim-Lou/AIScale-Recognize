# 环境变量配置示例
# 将此文件复制为.env并根据需要修改值

# 后端服务器端口
PORT=5001

# 允许的CORS源地址（前端应用地址）
CORS_ORIGIN=http://localhost:5173

# JWT密钥（生产环境应使用强密钥）
JWT_SECRET=your_strong_jwt_secret_here

# JWT令牌过期时间
TOKEN_EXPIRE=24h

# 前端使用的环境变量（需在Vite配置中启用）
# REACT_APP_API_BASE_URL=http://localhost:5001/api
# REACT_APP_BACKEND_BASE_URL=http://localhost:5001