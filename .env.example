# 环境变量配置示例
# 将此文件复制为.env并根据需要修改值

# 后端服务器端口
PORT=5001

# 允许的CORS源地址（前端应用地址）
CORS_ORIGIN=http://localhost:5173

# JWT密钥（生产环境应使用强密钥，用于Web界面认证）
# 部署时会自动替换为随机生成的强密钥
JWT_SECRET=your_strong_jwt_secret_here

# JWT令牌过期时间
TOKEN_EXPIRE=24h

# 密钥生成器验证密钥（用于调用密钥生成API）
# 部署时会自动替换为随机生成的强密钥
KEY_GENERATOR_SECRET=your_strong_key_generator_secret_here

# 设备注册密钥（用于设备注册验证 - 对应API文档中的设备注册功能）
DEVICE_REGISTRATION_KEY=reg-key-argmwRyvkCIYWE3EMcgMU0Dfvxmnnmzc

# 设备认证配置（对应API文档中的设备ID+API密钥双重认证机制）
# 注：实际设备ID和API密钥通过设备注册接口动态生成，此配置仅为示例

# 前端使用的环境变量（需在Vite配置中启用）
# REACT_APP_API_BASE_URL=http://localhost:5001/api
# REACT_APP_BACKEND_BASE_URL=http://localhost:5001

# 外部API相关配置
# 外部API端口（如需与内部API分开部署）
# EXTERNAL_API_PORT=5001

# 设备API限流配置（每设备每分钟最大请求数）
# DEVICE_RATE_LIMIT=60